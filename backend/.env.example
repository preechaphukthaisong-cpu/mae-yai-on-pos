# Required runtime configuration. Never commit real values.
PORT=8080
DATABASE_URL=postgresql://maeyai_sync:CHANGE_ME@127.0.0.1:5432/maeyai_sync
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# 32 random bytes, base64 encoded. Used only to encrypt Drive refresh tokens at rest.
TOKEN_ENCRYPTION_KEY_BASE64=REPLACE_WITH_BASE64_32_BYTE_KEY
# Optional; set only when enabling Drive mirror.
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
BACKUP_RETENTION_FULL=3
MAX_BACKUP_BYTES=536870912
