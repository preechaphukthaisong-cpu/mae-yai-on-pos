<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <application
        android:name=".app.PosApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity android:name=".feature.inventory.InventoryActivity" android:exported="false">
            <intent-filter>
                <action android:name="com.maeyaion.pos.action.INVENTORY" />
            </intent-filter>
        </activity>
        <activity android:name=".feature.barcode.BarcodeActivity" android:exported="false">
            <intent-filter>
                <action android:name="com.maeyaion.pos.action.BARCODE" />
            </intent-filter>
        </activity>
        <activity android:name=".feature.sales.SalesActivity" android:exported="false"><intent-filter><action android:name="com.maeyaion.pos.action.SALES" /></intent-filter></activity>
        <activity android:name=".feature.history.HistoryActivity" android:exported="false"><intent-filter><action android:name="com.maeyaion.pos.action.HISTORY" /></intent-filter></activity>
        <activity android:name=".feature.store.StoreActivity" android:exported="false"><intent-filter><action android:name="com.maeyaion.pos.action.STORE" /></intent-filter></activity>
        <activity android:name=".feature.reports.ReportsActivity" android:exported="false"><intent-filter><action android:name="com.maeyaion.pos.action.REPORTS" /></intent-filter></activity>
        <activity android:name=".app.MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
