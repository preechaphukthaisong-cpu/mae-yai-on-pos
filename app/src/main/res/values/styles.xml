<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/pos_emerald</item>
        <item name="android:colorControlActivated">@color/pos_emerald</item>
        <item name="android:colorControlHighlight">@color/pos_mint</item>
        <item name="android:colorControlNormal">@color/pos_muted</item>
        <item name="android:colorButtonNormal">@color/pos_mint</item>
        <item name="android:textColorPrimary">@color/pos_text</item>
        <item name="android:textColorSecondary">@color/pos_text_secondary</item>
        <item name="android:windowBackground">@color/pos_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:navigationBarColor">@color/pos_white</item>
        <item name="android:statusBarColor">@color/pos_white</item>
        <item name="android:buttonStyle">@style/PosActionButton</item>
        <item name="android:textViewStyle">@style/PosBodyText</item>
        <item name="android:editTextStyle">@style/PosInput</item>
        <item name="android:editTextColor">@color/pos_text</item>
    </style>

    <style name="PosActionButton" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/bg_pos_button</item>
        <item name="android:textColor">@color/pos_forest</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:fontFamily">sans</item>
    </style>

    <style name="PosBodyText" parent="@android:style/Widget.Material.TextView">
        <item name="android:textColor">@color/pos_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans</item>
    </style>

    <style name="PosInput" parent="@android:style/Widget.Material.EditText">
        <item name="android:textColor">@color/pos_text</item>
        <item name="android:textColorHint">@color/pos_muted</item>
        <item name="android:backgroundTint">@color/pos_emerald</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>
</resources>
